    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.5",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.2",
    "esbuild": "^0.28.2",
    "express": "^5.2.1",
    "jspdf": "^4.2.0",
    "jspdf-autotable": "^5.0.5",
    "lucide-react": "^0.544.0",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.6",
    "otplib": "^13.4.0",
    "papaparse": "^5.5.3",
    "pdfjs-dist": "^5.4.296",
    "pg": "^8.16.3",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "serverless-http": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
